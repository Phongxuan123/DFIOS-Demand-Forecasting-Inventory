# Cấu hình riêng cho máy của bạn. Copy thành BE/.env.local (file này không được commit).
# Thứ tự ưu tiên: biến môi trường của shell > BE/.env.local > BE/.env
# Dùng để chạy với Postgres local (docker compose) thay vì database dùng chung của nhóm.

# Postgres chạy bằng `docker compose up -d` ở thư mục gốc repo
DATABASE_URL=postgresql+psycopg2://dfios:dfios123@localhost:5432/dfios

# Dữ liệu M5 (mỗi thành viên đã có) – đường dẫn tuyệt đối tới 2 file CSV
M5_SALES_CSV_PATH=C:/path/to/m5/sales_train_evaluation.csv
M5_CALENDAR_CSV_PATH=C:/path/to/m5/calendar.csv

# Thư mục chứa artifact (parquet, c3ok_*.csv) – mặc định BE/scripts; artifact MODEL đặt ở BE/MODEL
DFIOS_ARTIFACTS_DIR=C:/path/to/repo/BE/scripts

# Tắt gửi email khi chạy local
SMTP_USER=
SMTP_PASSWORD=

# Scheduler ML chạy nền (1 = bật, 0 = tắt)
DFIOS_SCHEDULER=1

# 1 = môi trường test tách biệt: backend từ chối khởi động nếu DATABASE_URL không phải localhost
DFIOS_LOCAL_ONLY=1
